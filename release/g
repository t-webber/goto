goto "$@" | while read -r line; do
    if [[ $line == "0" ]]; then
        ChangeLocation=true
    elif [[ $line != "1" ]]; then
        Location=$line
    fi
done

echo "ChangeLocation: $ChangeLocation"
echo "Location: $Location"

if [[ $ChangeLocation = true && -d $Location ]]; then
    cd $Location
else
    echo $Location
fi
